# Method (agent) model - any OpenAI-compatible endpoint
AGENT_BASE_URL=https://your.agent.endpoint/v1
AGENT_API_KEY=YOUR_AGENT_KEY

# Judge model - a separate endpoint, usually a stronger model
JUDGE_BASE_URL=https://your.judge.endpoint/v1
JUDGE_API_KEY=YOUR_JUDGE_KEY
JUDGE_MODEL=gpt-4o

# Optional: proxy for crawling foreign sites (also picked up by the agent/judge
# clients, so only enable it when the proxy is up)
CRAWL_PROXY=http://127.0.0.1:7897
