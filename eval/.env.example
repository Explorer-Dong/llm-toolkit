# Model endpoint - any OpenAI-compatible endpoint with function calling
BASE_URL=https://api.example.com/v1
API_KEY=sk-xxx
MODEL_NAME=Qwen3.5-9B

# web search tool (Serper Google Search, SERPER_API_KEY accepts a comma-separated pool; keys are rotated with per-key quota checks)
SERPER_API_KEY=xxx
# web read tool (Crawl4AI deployed locally)
CRAWL4AI_URL=http://localhost:11235
CRAWL4AI_TOKEN=your-crawl4ai-token

# LLM-as-a-judge
JUDGE_BASE_URL=https://your.judge.endpoint/v1
JUDGE_API_KEY=YOUR_JUDGE_KEY
JUDGE_MODEL=gpt-4o
