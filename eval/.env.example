# =====
# Model endpoint - any OpenAI-compatible endpoint with function calling
# =====

# base model
BASE_URL=https://api.example.com/v1
API_KEY=sk-xxx
MODEL_NAME=Qwen3.5-9B

# judge model
JUDGE_BASE_URL=https://your.judge.endpoint/v1
JUDGE_API_KEY=YOUR_JUDGE_KEY
JUDGE_MODEL=gpt-4o

# =====
# Tool endpoint - setup with --{tool}-provider {name}
# =====

# Default search service: Serper (multi-key supported)
SERPER_API_KEY=xxxkey1,xxxkey2,xxxkey3
# Default fetch service: Crawl4AI (deployed locally)
CRAWL4AI_URL=http://localhost:11235
CRAWL4AI_TOKEN=your-crawl4ai-token
# (Optional) DeepSeek search/fetch service
DS_TOOL_URL=https://api.deepseek.com/v1/tools
DS_TOOL_KEY=your-deepseek-api-key
